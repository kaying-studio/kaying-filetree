{
  "name": "@kayingai/kaying-filetree",
  "version": "0.1.1",
  "description": "Framework-agnostic file tree + preview component (Web Component + Shadow DOM + Shiki)",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaying-studio/kaying-filetree.git"
  },
  "homepage": "https://github.com/kaying-studio/kaying-filetree#readme",
  "bugs": {
    "url": "https://github.com/kaying-studio/kaying-filetree/issues"
  },
  "keywords": [
    "file-tree",
    "file-explorer",
    "code-preview",
    "web-components",
    "custom-elements",
    "shadow-dom",
    "shiki",
    "syntax-highlighting",
    "chatgpt-codex",
    "typescript",
    "lit"
  ],
  "author": "Kaying Studio",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.2.0",
    "shiki": "^1.24.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "PUBLISH.md"
  ]
}
